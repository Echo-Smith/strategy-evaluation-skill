{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Echo-Smith/writing-agent-benchmark/main/schemas/suite-manifest.schema.json",
  "title": "WABench suite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "version", "name", "partition", "visibility", "caseRefs", "coverage", "privacy", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "wabench.v1"},
    "suiteId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,120}$"},
    "version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "maxLength": 2000},
    "partition": {"enum": ["development", "public_holdout", "private_holdout", "red_team", "live_probe"]},
    "visibility": {"enum": ["public", "private"]},
    "caseRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,120}$"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskTypes", "capabilities", "riskTags"],
      "properties": {
        "taskTypes": {"type": "array", "uniqueItems": true, "items": {"enum": ["topic", "writing", "polish", "dedupe", "abnormal"]}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "riskTags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowsRawText", "publicationPolicy"],
      "properties": {
        "allowsRawText": {"type": "boolean"},
        "publicationPolicy": {"enum": ["full", "redacted", "aggregate_only"]}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
