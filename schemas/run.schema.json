{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Echo-Smith/writing-agent-benchmark/main/schemas/run.schema.json",
  "title": "WABench run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "suiteId", "candidateId", "adapterId", "runnerVersion", "environment", "trafficType", "status", "startedAt", "outputRefs"],
  "properties": {
    "schemaVersion": {"const": "wabench.v1"},
    "runId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,120}$"},
    "suiteId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,120}$"},
    "candidateId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,120}$"},
    "adapterId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$"},
    "runnerVersion": {"type": "string", "maxLength": 80},
    "environment": {"enum": ["local", "test", "staging", "production"]},
    "trafficType": {"enum": ["user", "smoke", "replay"]},
    "evaluationRunId": {"type": "string", "maxLength": 120},
    "status": {"enum": ["queued", "running", "completed", "completed_with_failures", "failed", "cancelled"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "outputRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,120}$"}},
    "runHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
