{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Echo-Smith/writing-agent-benchmark/main/schemas/release-decision.schema.json",
  "title": "WABench release decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "candidateId", "reportRefs", "decision", "evidence", "exceptions", "rollback", "owner", "decidedAt"],
  "properties": {
    "schemaVersion": {"const": "wabench.v1"},
    "decisionId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,120}$"},
    "candidateId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,120}$"},
    "reportRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,120}$"}},
    "decision": {"enum": ["release", "hold", "reject", "rollback"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "exceptions": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "featureFlags", "conditions"],
      "properties": {
        "enabled": {"type": "boolean"},
        "featureFlags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "owner": {"type": "string", "minLength": 1, "maxLength": 120},
    "decidedAt": {"type": "string", "format": "date-time"}
  }
}
